<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_kode_generator" model="ir.ui.view">
        <field name="name">product.template.form.kode.generator</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_kode_modal.product_template_form_view_kode_modal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='kode_modal']" position="replace">
                <label for="kode_modal" string="Kode Modal"/>
                <div class="d-flex align-items-center gap-2">
                    <field name="kode_modal" nolabel="1"/>
                    <button name="action_generate_kode1" type="object"
                            string="Label 1" class="btn btn-sm btn_kode_modal"/>
                    <button name="action_generate_kode2" type="object"
                            string="Label 2" class="btn btn-sm btn_kode_modal"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
